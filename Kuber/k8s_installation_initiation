sudo cp -i /etc/kubernetes/admin.conf \
$HOME/.kube/config

sudo chown $(id -u):$(id -g) \
$HOME/.kube/config

# Configure kubectl for root:
export KUBECONFIG=/etc/kubernetes/admin.conf

